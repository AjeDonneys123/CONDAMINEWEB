{
  "name": "condamine-project",
  "version": "1.0.0",
  "scripts": {
    "start": "node server/server.js",
    "server-dev": "nodemon --ignore 'server/version.json' --ignore 'update.txt' --ignore 'history.txt' server/server.js",
    "client": "npm run dev --prefix client",
    "apply": "node apply.js",
    "git-auto": "node git-auto.js",
    "build": "npm install && npm install --prefix client && npm run build --prefix client",
    "dev": "node apply.js & node git-auto.js & npm run server-dev & npm run client"
  },
  "dependencies": {
    "@google/generative-ai": "^0.1.3",
    "adm-zip": "^0.5.14",
    "chokidar": "^3.6.0",
    "clipboardy": "^5.0.2",
    "cloudinary": "^1.41.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^126.0.0",
    "mongoose": "7.8.2",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.9.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
