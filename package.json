{
  "name": "condamine-project",
  "version": "1.0.0",
  "scripts": {
    "start": "nodemon server/server.js",
    "client": "npm run dev --prefix client",
    "apply": "node apply.js",
    "dev": "node apply.js & npm run start & npm run client",
    "stop": "killall -9 node",
    "snap": "node snap.js",
    "zip": "node zip.js"
  },
  "nodemonConfig": {
    "ignore": ["history.txt", "update.txt", "client/*", "snapshot.txt"]
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "express": "^4.18.2",
    "dotenv": "^16.0.3",
    "mongoose": "7.8.2",
    "@google/generative-ai": "0.1.3",
    "node-fetch": "2",
    "multer": "^1.4.5-lts.1",
    "cloudinary": "^1.41.0",
    "multer-storage-cloudinary": "^4.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}