{
  "name": "condamine-pro",
  "version": "1.161.0",
  "scripts": {
    "start": "node server/server.js",
    "server-dev": "nodemon --ignore 'update.txt' --ignore 'apply_status.json' --ignore 'temp_diff.json' server/server.js",
    "client": "npm run dev --prefix client",
    "test": "node tests/integrity.test.js",
    "dev": "concurrently -n \"APPLY,MAGIC,SERVER,CLIENT\" -c \"green,yellow,magenta,cyan\" \"node apply.js\" \"node magic-paste.js\" \"npm run server-dev\" \"npm run client\"",
    "build": "npm install --prefix client && npm run build --prefix client"
  },
  "dependencies": {
    "@google/generative-ai": "^0.1.3",
    "bcryptjs": "^2.4.3",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "googleapis": "^126.0.0",
    "helmet": "^7.1.0",
    "mongoose": "7.8.2",
    "node-fetch": "^2.7.0",
    "multer": "^1.4.5-lts.1",
    "clipboardy": "^4.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.3"
  }
}