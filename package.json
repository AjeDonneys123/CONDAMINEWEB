{
  "name": "condamine-project",
  "version": "1.0.0",
  "scripts": {
    "start": "node server/server.js",
    "server-dev": "nodemon --ignore 'update.txt' --ignore 'apply_status.json' --ignore 'server/version.json' --ignore 'snapshot.txt' server/server.js",
    "client": "npm run dev --prefix client",
    "apply": "node apply.js",
    "dev": "node apply.js & node magic-paste.js & npm run server-dev & npm run client",
    "kill": "lsof -ti:3000 | xargs kill -9"
  },
  "dependencies": {
    "@google/generative-ai": "^0.1.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^126.0.0",
    "mongoose": "7.8.2",
    "node-fetch": "^2.7.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}