{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ],
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "https://hgeoentraineur.onrender.com/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^(?!/api/).*$",
      "dest": "/index.html"
    }
  ]
}
