{
  "manifest_version": 3,
  "name": "CapConda",
  "version": "0.3.2",
  "description": "Extension élève CondaWeb pour utiliser Gemini et réaliser des captures d’écran par sélection.",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "sidePanel",
    "activeTab",
    "downloads",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "https://condaweb.vercel.app/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "https://condaweb.vercel.app/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "gemini-page.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["capture.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "bridge.js"
      ],
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "https://condaweb.vercel.app/*"
      ]
    }
  ],
  "action": {
    "default_title": "CapConda",
    "default_popup": "popup.html"
  },
  "commands": {
    "capture-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Capturer une zone de l’écran"
    },
    "capture-clipboard": {
      "suggested_key": {
        "default": "Ctrl+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "Capturer une zone et la copier dans le presse-papiers"
    }
  }
}
