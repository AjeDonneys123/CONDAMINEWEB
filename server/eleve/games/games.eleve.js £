const express = require('express');
const router = express.Router();
const mongoose = require('mongoose');

/**
 * 🎮 ROUTEUR JEUX ÉLÈVE V2
 * Assure la visibilité des jeux pour William (5B)
 */

// 1. Liste des activités Jeux pour l'élève
router.get('/list/:studentId', async (req, res) => {
    try {
        const Student = mongoose.model('Student');
        const GameLevel = mongoose.model('GameLevel');
        
        const student = await Student.findById(req.params.studentId).lean();
        if (!student) return res.status(404).json({ error: "Élève non trouvé" });

        // Nettoyage pour William Acosta (5B)
        const myClass = (student.currentClass || "").trim().toUpperCase();
        const myClassNoSpace = myClass.replace(/\s+/g, ''); 

        // On cherche les jeux pour la classe brute, nettoyée, ou Julian spécifiquement
        const games = await GameLevel.find({
            $or: [
                { targetClassrooms: myClass, isAllClass: true },
                { targetClassrooms: myClassNoSpace, isAllClass: true },
                { assignedStudents: student._id }
            ]
        }).sort({ createdAt: -1 }).lean();

        console.log(`🔍 [GAMES] ${games.length} jeux trouvés pour ${student.firstName} (${myClass})`);
        res.json(games);
    } catch (e) {
        console.error("❌ [API-GAMES] Error:", e.message);
        res.status(500).json([]);
    }
});

// 2. Liste des Skins / Modalités (Studio)
router.get('/skins', async (req, res) => {
    try {
        const StudioProject = mongoose.model('StudioProject');
        const projects = await StudioProject.find({}, 'title scenes generatedCode').sort({ updatedAt: -1 }).lean();
        res.json(projects);
    } catch (e) {
        console.error("❌ [API-SKINS] Error:", e.message);
        res.status(500).json([]);
    }
});

module.exports = router;