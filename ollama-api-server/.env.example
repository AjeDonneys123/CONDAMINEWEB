PORT=8787
HOST=0.0.0.0

# URL de l'API Ollama sur la machine qui héberge les modèles.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Modèle utilisé si le site ne précise rien.
# Exemples:
# - llama3.1:8b
# - qwen2.5:7b-instruct
# - mistral:7b
DEFAULT_MODEL=llama3.1:8b

# Sécurité simple pour éviter que n'importe qui consomme ton serveur.
# Mets une phrase longue, puis envoie-la côté site avec x-api-key.
API_KEY=change-moi-avec-une-cle-longue

# Origines autorisées. "*" accepte tout, pratique en test.
# En production, préfère par exemple:
# ALLOWED_ORIGINS=https://ton-site.fr,http://localhost:5173
ALLOWED_ORIGINS=*

# Limites anti-abus raisonnables pour une classe.
MAX_PROMPT_CHARS=12000
MAX_OUTPUT_TOKENS=900
REQUEST_TIMEOUT_MS=120000
