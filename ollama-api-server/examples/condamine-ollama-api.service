[Unit]
Description=Condamine Ollama API Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/jean/condamine-ollama-api-server
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
